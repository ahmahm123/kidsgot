generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HUMAN
  ADMIN
}

enum AgentStatus {
  ACTIVE
  DISABLED
}

enum TaskStatus {
  DRAFT
  POSTED
  INVITED
  OPEN
  ASSIGNED
  IN_PROGRESS
  REVIEW
  COMPLETED
  DISPUTED
  CANCELED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EscrowStatus {
  CREATED
  FUNDED
  RELEASED
  DISPUTED
  RESOLVED
}

enum PayoutStatus {
  PENDING
  PAID
}

model User {
  id                String @id @default(cuid())
  email             String @unique
  passwordHash      String
  role              UserRole @default(HUMAN)
  verified          Boolean @default(false)
  verifyToken       String?
  trusted           Boolean @default(false)
  createdAt         DateTime @default(now())
  profile           HumanProfile?
  notifications     Notification[]
  payouts           Payout[]
  taskAssignments   TaskAssignment[]
  submissions       Submission[]
}

model AgentClient {
  id         String @id @default(cuid())
  name       String
  apiKeyHash String @unique
  status     AgentStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  tasks      Task[]
}

model HumanProfile {
  id                  String @id @default(cuid())
  userId              String @unique
  name                String
  bio                 String?
  skills              String[]
  hourlyRate          Float?
  fixedRate           Float?
  city                String?
  country             String?
  availability        Boolean @default(true)
  languages           String[]
  rating              Float @default(5)
  completedTasksCount Int @default(0)
  user                User @relation(fields:[userId], references:[id])
}

model Task {
  id                 String @id @default(cuid())
  createdByAgentId   String
  title              String
  description        String
  requiredSkills     String[]
  city               String?
  country            String?
  deadline           DateTime
  budget             Float
  acceptanceCriteria String
  status             TaskStatus @default(DRAFT)
  createdAt          DateTime @default(now())
  agent              AgentClient @relation(fields:[createdByAgentId], references:[id])
  invitations        TaskInvitation[]
  assignment         TaskAssignment?
  messages           Message[]
  submissions        Submission[]
  escrow             Escrow?
}

model TaskInvitation {
  id      String @id @default(cuid())
  taskId  String
  userId  String
  status  InvitationStatus @default(PENDING)
  task    Task @relation(fields:[taskId], references:[id])
  user    User @relation(fields:[userId], references:[id])

  @@unique([taskId, userId])
}

model TaskAssignment {
  id         String @id @default(cuid())
  taskId      String @unique
  userId      String
  assignedAt  DateTime @default(now())
  task        Task @relation(fields:[taskId], references:[id])
  user        User @relation(fields:[userId], references:[id])
}

model Message {
  id         String @id @default(cuid())
  taskId      String
  senderType  String
  content     String
  createdAt   DateTime @default(now())
  task        Task @relation(fields:[taskId], references:[id])
}

model Submission {
  id         String @id @default(cuid())
  taskId      String
  userId      String
  note        String?
  proofFiles  String[]
  createdAt   DateTime @default(now())
  task        Task @relation(fields:[taskId], references:[id])
  user        User @relation(fields:[userId], references:[id])
}

model Escrow {
  id         String @id @default(cuid())
  taskId      String @unique
  amount      Float
  status      EscrowStatus @default(CREATED)
  fundedAt    DateTime?
  releasedAt  DateTime?
  task        Task @relation(fields:[taskId], references:[id])
}

model Payout {
  id        String @id @default(cuid())
  userId    String
  taskId    String
  amount    Float
  status    PayoutStatus @default(PENDING)
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id])
}

model AuditLog {
  id         String @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
